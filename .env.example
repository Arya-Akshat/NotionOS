# Notion API Key and Database
NOTION_API_KEY=
NOTION_DATABASE_ID=

# LLM Providers
GROQ_API_KEY=        # Primary LLM provider (Groq)
GEMINI_API_KEY=      # Fallback LLM provider (Google Gemini)

# External Tools
TAVILY_API_KEY=      # Web search capability
GITHUB_TOKEN=        # GitHub automation

# Local Database
DATABASE_URL=sqlite:///./notionos.db

# MCP Configuration
NOTION_MCP_ENABLED=true
NOTION_MCP_MODE=hybrid
